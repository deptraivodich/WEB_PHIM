# Frontend: empty = same origin; Vite proxies /api and /health to API_PROXY_TARGET.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8000

# Backend (load once using uvicorn --env-file .env)
SQLITE_PATH=backend/interactions.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_SECONDS=28800

# Firestore Admin SDK. Never use a VITE_ prefix for server credentials.
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
# For local emulator ONLY: use a demo-* project and no cloud credentials.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=web_phim
CLICKHOUSE_USER=webphim
CLICKHOUSE_PASSWORD=
